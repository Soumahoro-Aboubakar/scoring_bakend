# Core
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/a90rchitect_football
BACKEND_URL=http://localhost:5000

# Automation switches
AUTOMATION_ENABLED=true
CRON_JOBS_ENABLED=true
COLLECT_ENABLED=true
ANALYSIS_ENABLED=true
VALIDATION_ENABLED=true
CLEANUP_ENABLED=true
ADVANCED_LOGS_ENABLED=true

# Scheduling, server timezone
CRON_TIMEZONE=UTC
COLLECT_CRON=*/30 10-23 * * *
ANALYSIS_CRON=*/20 * * * *
VALIDATION_CRON=*/45 * * * *
CLEANUP_CRON=15 3 * * *
COLLECT_TARGET_OFFSET_DAYS=1
VALIDATION_TARGET_OFFSET_DAYS=-1

# AI providers and models
AI_PROVIDER=OPENAI
COLLECTION_AI_PROVIDER=OPENAI
ANALYSIS_AI_PROVIDER=OPENAI
VALIDATION_AI_PROVIDER=OPENAI
DEFAULT_MODEL=gpt-5.4-mini
COLLECTION_MODEL=gpt-5.4-mini
ANALYSIS_MODEL=gpt-5.5
VALIDATION_MODEL=gpt-5.4-mini
AI_WEB_SEARCH_ENABLED=true
AI_MAX_RETRIES=2
OPENAI_API_KEY=
GEMINI_API_KEY=

# Data and criteria
BBC_FIXTURES_BASE_URL=https://www.bbc.com/sport/football/scores-fixtures
TRUSTED_FALLBACK_SOURCES=bbc.com,espn.com,skysports.com,flashscore.com,sofascore.com
COLLECTED_TEMP_TTL_HOURS=48
MAX_MATCHES_PER_RUN=80
ANALYSIS_BATCH_SIZE=8
VALIDATION_BATCH_SIZE=60
MIN_BBC_MATCHES_BEFORE_FALLBACK=5
ANALYSIS_CRITERIA="Forme récente, puissance offensive, stabilité défensive, domicile/extérieur, blessures, calendrier, tendances buts, probabilités, risques. Retour JSON strict."
